set(notices "${CMAKE_CURRENT_BINARY_DIR}/licenses")
file(MAKE_DIRECTORY "${notices}")
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" "${notices}/EnjoySync-AGPL.txt" COPYONLY)
configure_file("${CMAKE_CURRENT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" "${notices}/THIRD_PARTY_NOTICES.md" COPYONLY)
configure_file("${juce_SOURCE_DIR}/LICENSE.md" "${notices}/JUCE.md" COPYONLY)
configure_file("${aoo_SOURCE_DIR}/LICENSE" "${notices}/AOO.txt" COPYONLY)
configure_file("${aoo_SOURCE_DIR}/deps/oscpack/LICENSE" "${notices}/oscpack.txt" COPYONLY)
configure_file("${opus_SOURCE_DIR}/COPYING" "${notices}/Opus.txt" COPYONLY)
configure_file("${mbedtls_SOURCE_DIR}/LICENSE" "${notices}/MbedTLS.txt" COPYONLY)
foreach(module IN ITEMS juce_core juce_graphics juce_audio_devices)
    file(GLOB_RECURSE license_files RELATIVE "${juce_SOURCE_DIR}/modules"
        "${juce_SOURCE_DIR}/modules/${module}/*LICENSE*" "${juce_SOURCE_DIR}/modules/${module}/*COPYING*")
    foreach(path IN LISTS license_files)
        get_filename_component(parent "${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${notices}/JUCE-components/${parent}")
        configure_file("${juce_SOURCE_DIR}/modules/${path}" "${notices}/JUCE-components/${path}" COPYONLY)
    endforeach()
endforeach()
configure_file("${juce_SOURCE_DIR}/modules/juce_graphics/image_formats/jpglib/README" "${notices}/JPEG.txt" COPYONLY)
if(APPLE)
    juce_add_bundle_resources_directory(EnjoySync "${notices}")
else()
    add_custom_command(TARGET EnjoySync POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${notices}" "$<TARGET_FILE_DIR:EnjoySync>/licenses")
endif()
